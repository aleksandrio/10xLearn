SUPABASE_URL=###
SUPABASE_KEY=###
# HMAC secret signing the guest-progress cookie. Optional in dev (falls back to
# an insecure default); set a strong random value in the deploy environment.
GUEST_PROGRESS_SECRET=###
# Deploy origin for building OAuth redirect URLs (e.g. https://app.example.com).
# Optional locally (falls back to the request origin).
PUBLIC_SITE_URL=###
# Google OAuth is a manual prerequisite: the provider is wired in
# supabase/config.toml under [auth.external.google], which reads the two vars
# below via env() substitution. Create a Google Cloud OAuth 2.0 Web client with
# redirect URI http://127.0.0.1:54321/auth/v1/callback (local) and paste the
# credentials here, then restart Supabase. Code is ready without it, but the
# flow won't complete until these are set.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=###
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=###
# Service-role key for the server-only admin client (account deletion). Bypasses
# RLS — set only in the deploy environment; must never reach the client bundle.
SUPABASE_SERVICE_ROLE_KEY=###