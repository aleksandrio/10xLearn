SUPABASE_URL=###
SUPABASE_KEY=###
# HMAC secret signing the guest-progress cookie. Optional in dev (falls back to
# an insecure default); set a strong random value in the deploy environment.
GUEST_PROGRESS_SECRET=###
# Deploy origin for building OAuth redirect URLs (e.g. https://app.example.com).
# Optional locally (falls back to the request origin).
PUBLIC_SITE_URL=###
# Google OAuth is a manual prerequisite: configure the Google provider (client
# id/secret + authorized redirect) in the Supabase project, and for local dev in
# supabase/config.toml under [auth.external.google]. Code is ready without it,
# but the flow won't complete until configured.