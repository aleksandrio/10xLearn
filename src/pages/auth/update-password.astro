---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

// The recovery link lands here with a PKCE `code`. Exchange it for a session
// (which sets the auth cookies via the SSR client) so the subsequent password
// update — POST /api/auth/update-password → updateUser — is authorized. Without
// this the update fails with "Auth session missing!". The PKCE code_verifier
// cookie set during the reset request must be present (same browser).
let error = Astro.url.searchParams.get("error");
const code = Astro.url.searchParams.get("code");

if (code && !error) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const { error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);
    if (exchangeError) {
      error = "This reset link is invalid or has expired. Request a new one.";
    }
  }
}
---

<Layout title="Set a new password">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Set a new password
      </h1>

      <form method="POST" action="/api/auth/update-password" class="space-y-4">
        <div>
          <label for="password" class="mb-1 block text-sm text-blue-100/80">New password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength="6"
            placeholder="Min. 6 characters"
            class="w-full rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-white placeholder:text-blue-100/40 focus-visible:ring-2 focus-visible:ring-purple-400 focus-visible:outline-none"
          />
        </div>
        {error && <p class="text-sm text-red-300">{error}</p>}
        <button
          type="submit"
          class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Update password
        </button>
      </form>
    </div>
  </div>
</Layout>
