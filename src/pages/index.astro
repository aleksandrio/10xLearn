---
import Layout from "@/layouts/Layout.astro";
import WorldMap from "@/components/game/WorldMap";
import { createClient } from "@/lib/supabase";
import { buildMapModel, type MapZone } from "@/lib/game";
import { readUnlockedZones, GUEST_PROGRESS_COOKIE } from "@/lib/guest-progress";
import { getUnlockedZoneSlugsForUser } from "@/lib/progress";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const user = Astro.locals.user;

let zones: MapZone[] = [];
let loadFailed = false;

if (supabase) {
  try {
    // Authed learners read their unlocked set from the DB (mission_completions);
    // guests keep the signed-cookie path untouched. `buildMapModel` is source-
    // agnostic, so the same call renders either set.
    const unlocked = user
      ? await getUnlockedZoneSlugsForUser(supabase, user.id)
      : await readUnlockedZones(Astro.cookies.get(GUEST_PROGRESS_COOKIE)?.value);
    zones = await buildMapModel(supabase, unlocked);
  } catch {
    loadFailed = true;
  }
}
---

<Layout title="10xLearn — World Map">
  {
    supabase && !loadFailed ? (
      <WorldMap client:load initialZones={zones} isAuthenticated={!!user} userEmail={user?.email ?? null} />
    ) : (
      <main class="mx-auto max-w-2xl px-4 py-10">
        <h1 class="text-2xl font-semibold tracking-tight">World map unavailable</h1>
        <p class="text-muted-foreground mt-2 text-sm">
          The learning content can&rsquo;t be loaded right now. Check that Supabase is configured, then reload the page.
        </p>
      </main>
    )
  }
</Layout>
