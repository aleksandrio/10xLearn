---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /**
   * Id of the page's `<main>`. Opt-in: when set, a skip link targeting it is
   * rendered first inside `<body>`. Pages that render no `<main>` (auth,
   * dashboard) simply omit it rather than shipping a link that dangles.
   */
  mainId?: string;
}

const { title = "10x Astro Starter", mainId } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      /* First focusable element on the page — ahead of the config banners, which
         contain links of their own. */
      mainId && (
        <a
          href={`#${mainId}`}
          class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-amber-300 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-950 focus:ring-2 focus:ring-amber-200 focus:ring-offset-2 focus:ring-offset-slate-950 focus:outline-none"
        >
          Skip to main content
        </a>
      )
    }
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
